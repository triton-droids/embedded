// ROS 2 Humble dev container for Linux hosts. See docs/devcontainer.md.
{
  "name": "Humanoid MuJoCo Simulation",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/embedded,type=bind",
  "workspaceFolder": "/workspaces/embedded",
  "remoteUser": "ros",
  "runArgs": [
    // DDS discovery is most reliable on the host network.
    "--network=host",
    "--shm-size=1g"
    // Optional GPU passthrough for rendering:
    // "--device=/dev/dri",      // GPU-accelerated RViz
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/.docker.xauth/xauth",
    // Keep laptop testing off the robot network: the Jetson uses domain 0.
    // Change both of these to talk to the robot (see docs/remote_rviz.md).
    "ROS_DOMAIN_ID": "0",
    "ROS_LOCALHOST_ONLY": "1"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:HOME}/.cache/triton-devcontainer,target=/tmp/.docker.xauth,type=bind"
  ],
  "initializeCommand": "bash .devcontainer/init-host.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
