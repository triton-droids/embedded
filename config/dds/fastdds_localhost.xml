<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile for Fast DDS processes on the robot that must meet the
     CycloneDDS local graph, chiefly the micro-ROS Agent (it embeds Fast DDS
     whatever RMW_IMPLEMENTATION says). scripts/dds_env.sh exports it as
     FASTRTPS_DEFAULT_PROFILES_FILE together with the CycloneDDS profile.

     The local CycloneDDS profile runs on loopback only. By default Fast DDS
     discovers by multicast, uses shared memory between local processes and
     advertises only the host's external addresses, none of which CycloneDDS
     can reach on loopback. This profile puts Fast DDS on loopback as well:
     UDPv4 on 127.0.0.1 only (no shared-memory transport), unicast discovery
     to 127.0.0.1 and loopback locators for discovery and user data. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>humanoid_udp_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="humanoid_loopback" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>humanoid_udp_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </metatrafficUnicastLocatorList>
      </builtin>
      <defaultUnicastLocatorList>
        <locator>
          <udpv4>
            <address>127.0.0.1</address>
          </udpv4>
        </locator>
      </defaultUnicastLocatorList>
    </rtps>
  </participant>
</profiles>
