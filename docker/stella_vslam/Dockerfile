# stella_vslam + stella_vslam_ros on ROS2 Jazzy (Ubuntu 24.04), headless.
# Built for linux/arm64 so the same image runs on the Mac (Apple Silicon) and the Pi 4.
# Upstream stella_vslam_ros ships Dockerfile.socket for ROS2 Humble; this is a Jazzy port of it.
#
# Contents:
#   /opt/stella_vslam                  core library (installed to /usr/local)
#   /opt/stella_vslam_examples/build   run_image_slam etc. (offline tests on image folders)
#   /ros2_ws                           stella_vslam_ros (ros2 run stella_vslam_ros run_slam ...)
#   /opt/vocab/orb_vocab.fbow          FBoW ORB vocabulary
#   v4l2_camera                        ROS2 USB camera driver (used on the robot)
#   socket_publisher                   streams map/frames to the socket viewer (Dockerfile.viewer)
FROM ros:jazzy-ros-base
ENV DEBIAN_FRONTEND=noninteractive

# Parallel build jobs. Default 2 keeps peak memory low (needed on small Docker VMs).
ARG JOBS=2

# Pinned sources (reproducible builds). Dates are commit dates.
ARG STELLA_VSLAM_COMMIT=525231147319bcd31242f981078c36d9272727b4          # tag 0.7.0, 2026-08-12
ARG STELLA_VSLAM_EXAMPLES_COMMIT=defc69eecc36e51cdda22885bb86954f08ad6887 # main, read 2026-11-03
ARG STELLA_VSLAM_ROS_COMMIT=186f623dd1c24ee83678f8e1da593801f450bbb3      # ros2 branch, 2025-09-26
ARG SOCKET_PUBLISHER_COMMIT=72b85ed39f28bb5e346d65c78b93b4bf5616eb42      # 0.0.2, 2025-01-19
ARG SIOCLIENT_COMMIT=ff6ef08e45c594e33aa6bc19ebdd07954914efe0             # as in upstream Dockerfile.socket
ARG FBOW_VOCAB_URL=https://github.com/stella-cv/FBoW_orb_vocab/raw/main/orb_vocab.fbow

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ca-certificates curl \
    libgoogle-glog-dev libsuitesparse-dev libyaml-cpp-dev libopencv-dev libeigen3-dev \
    libprotobuf-dev protobuf-compiler \
    ros-${ROS_DISTRO}-libg2o \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-v4l2-camera ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# socket.io-client-cpp (needed by socket_publisher)
WORKDIR /tmp
RUN git clone https://github.com/shinsumicco/socket.io-client-cpp.git \
    && cd socket.io-client-cpp && git checkout ${SIOCLIENT_COMMIT} \
    && git submodule update --init \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_UNIT_TESTS=OFF \
       -DCMAKE_CXX_FLAGS="-include cstdint" \
    && cmake --build build -j${JOBS} && cmake --install build \
    && cd /tmp && rm -rf socket.io-client-cpp
ENV sioclient_DIR=/usr/local/lib/cmake/sioclient

# stella_vslam core. g2o comes from ros-jazzy-libg2o and is linked dynamically (LGPL part).
WORKDIR /opt
RUN git clone https://github.com/stella-cv/stella_vslam.git \
    && cd stella_vslam && git checkout ${STELLA_VSLAM_COMMIT} \
    && git submodule update --init --recursive \
    && CMAKE_PREFIX_PATH=/opt/ros/${ROS_DISTRO} cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j${JOBS} && cmake --install build && ldconfig \
    && rm -rf build

# socket_publisher (browser viewer bridge)
WORKDIR /tmp
RUN git clone https://github.com/stella-cv/socket_publisher.git \
    && cd socket_publisher && git checkout ${SOCKET_PUBLISHER_COMMIT} \
    && CMAKE_PREFIX_PATH=/opt/ros/${ROS_DISTRO} cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j${JOBS} && cmake --install build && ldconfig \
    && cd /tmp && rm -rf socket_publisher

# Example executables (run_image_slam for offline tests on image folders)
WORKDIR /opt
RUN git clone https://github.com/stella-cv/stella_vslam_examples.git \
    && cd stella_vslam_examples && git checkout ${STELLA_VSLAM_EXAMPLES_COMMIT} \
    && git submodule update --init --recursive \
    && CMAKE_PREFIX_PATH=/opt/ros/${ROS_DISTRO} cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j${JOBS}

# stella_vslam_ros
WORKDIR /ros2_ws/src
# Jazzy patches (upstream targets Humble). Each is checked with grep so a no-op patch fails the build.
#  1. ament_export_targets(... HAS_LIBRARY_TARGET) already adds the library_path env hook; the explicit
#     one makes CMake fail with "Files to be generated by multiple different commands".
#  2. Jazzy's cv_bridge only ships cv_bridge.hpp (cv_bridge.h was removed).
RUN git clone https://github.com/stella-cv/stella_vslam_ros.git \
    && cd stella_vslam_ros && git checkout ${STELLA_VSLAM_ROS_COMMIT} \
    && git submodule update --init --recursive \
    && sed -i '/^if(NOT WIN32)$/,/^endif()$/d' CMakeLists.txt \
    && ! grep -q ENVIRONMENT_HOOK_LIBRARY_PATH CMakeLists.txt \
    && sed -i 's#<cv_bridge/cv_bridge.h>#<cv_bridge/cv_bridge.hpp>#' src/stella_vslam_ros.h \
    && grep -q 'cv_bridge/cv_bridge.hpp' src/stella_vslam_ros.h
WORKDIR /ros2_ws
RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --parallel-workers ${JOBS} --cmake-args -DCMAKE_BUILD_TYPE=Release" \
    && rm -rf build log

# Vocabulary
RUN mkdir -p /opt/vocab && curl -fsSL "${FBOW_VOCAB_URL}" -o /opt/vocab/orb_vocab.fbow

# Build-time check: the ROS node and the socket viewer bridge are both present.
RUN bash -c "source /ros2_ws/install/setup.bash && ros2 pkg executables stella_vslam_ros | grep -q run_slam" \
    && ls /usr/local/lib/libsocket_publisher.so

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
WORKDIR /workspace
CMD ["bash"]
