# Settings for the SLAM service on the Pi. Edit, then: sudo systemctl restart alohamini-slam
# (install.sh copies this to /opt/alohamini-slam/slam.env and does not overwrite an existing one)

# Camera device. Best guess is LeRobot's udev name; install.sh falls back to /dev/v4l/by-id/*-video-index0.
CAMERA_DEVICE=/dev/am_camera_forward
IMAGE_WIDTH=640
IMAGE_HEIGHT=480
# YUYV at 640x480/30 fps fits USB 2.0. Check with: v4l2-ctl -d $CAMERA_DEVICE --list-formats-ext
PIXEL_FORMAT=YUYV

# mapping: build a new map, saved to maps/map_<timestamp>.msg when the service stops
# localization: track against MAP_IN without changing it
MODE=mapping
MAP_IN=

# socket_publisher = browser viewer at http://<pi-ip>:3001 ; none = no viewer (saves CPU)
VIEWER=socket_publisher

CONFIG=/config/elp_fisheye.yaml

# true only once camera -> base_link -> odom TF is published on the robot
PUBLISH_TF=false
