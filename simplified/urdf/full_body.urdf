  <!-- ROS camera convention (X forward, Y left, Z up). The RealSense driver
       publishes camera_color_optical_frame and the other optical frames under it. -->
  <link name="camera_link"/>
  <!-- Shared RP2040/IMU board. Its axes follow the head frame until the chip
       orientation on the board is confirmed. -->
  <link name="head_imu_link"/>
  <!-- Head plate on the two top 1010 rails, tray front flush with the front rail. -->
  <joint name="head_mount_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_base_link"/>
    <origin rpy="0 0 0" xyz="0 0.0324 0.3914"/>
  </joint>
  <!-- Positive yaw turns the camera to the robot's left. -->
  <joint name="neck_yaw_joint" type="revolute">
    <parent link="head_base_link"/>
    <child link="neck_yaw_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.9" lower="-1.7453" upper="1.7453" velocity="4.7"/>
    <dynamics damping="0.05"/>
  </joint>
  <!-- Positive pitch tilts the camera up. -->
  <joint name="neck_pitch_joint" type="revolute">
    <parent link="neck_yaw_link"/>
    <child link="neck_pitch_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.141"/>
    <axis xyz="1 0 0"/>
    <limit effort="1.9" lower="-1.3090" upper="1.3090" velocity="4.7"/>
    <dynamics damping="0.05"/>
  </joint>
  <joint name="camera_joint" type="fixed">
    <parent link="neck_pitch_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 1.570796" xyz="-0.0175 0.0083 0"/>
  </joint>
  <joint name="head_imu_joint" type="fixed">
    <parent link="neck_pitch_link"/>
    <child link="head_imu_link"/>
    <origin rpy="0 0 0" xyz="0 -0.0325 0.0098"/>
  </joint>
