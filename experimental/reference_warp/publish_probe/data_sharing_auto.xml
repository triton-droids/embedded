<?xml version="1.0" encoding="UTF-8"?>
<!-- Capability experiment only. AUTO skips unsupported unbounded types.
     This is not end-to-end zero-copy configuration for the Python stack. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <data_writer profile_name="loan_capability_writer" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>AUTO</kind></data_sharing>
    </qos>
  </data_writer>
  <data_reader profile_name="loan_capability_reader" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    <qos><data_sharing><kind>AUTO</kind></data_sharing></qos>
  </data_reader>
</profiles>
