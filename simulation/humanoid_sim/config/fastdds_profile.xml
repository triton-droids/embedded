<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS resource policy for the simulated stack.

  Measured symptom this targets: a single rclpy publish call occasionally waits
  ~330 ms on a 300-byte Imu message, while a physics step costs 0.05 ms and the
  sample lock is held for microseconds. A stall that size cannot be compute; it
  is the writer waiting on history resources.

  Nothing here changes reliability or history depth, so the ROS QoS contract
  (200 Hz reliable /joint_states, reliable Safety IMU) is untouched:
    * topic  -> resourceLimitsQos: room for a burst instead of a full history,
    * writer -> PREALLOCATED_WITH_REALLOC memory policy,
    * writer -> max_blocking_time capped, so one slow write degrades to a
                dropped state sample instead of freezing the thread ~300 ms.

  max_blocking_time is the deliberate trade-off. State streams are superseded by
  the next sample, so a bounded drop beats a long stall. Raise it back to 0.1 s
  if a consumer must never miss a reliable sample.

  Element placement follows Fast DDS's own parser: resourceLimitsQos is only
  accepted inside <topic>, historyMemoryPolicy only as a direct child of
  <data_writer>/<data_reader>. Applied only when the launch sets
  FASTRTPS_DEFAULT_PROFILES_FILE via dds_tuning:=on.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <topic profile_name="humanoid_state_topic" is_default_profile="true">
    <resourceLimitsQos>
      <max_samples>20000</max_samples>
      <max_instances>25</max_instances>
      <max_samples_per_instance>5000</max_samples_per_instance>
      <allocated_samples>1024</allocated_samples>
    </resourceLimitsQos>
  </topic>

  <data_writer profile_name="humanoid_state_writer" is_default_profile="true">
    <qos>
      <publishMode>
        <kind>ASYNCHRONOUS</kind>
      </publishMode>
      <reliability>
        <kind>RELIABLE</kind>
        <max_blocking_time>
          <sec>0</sec>
          <nanosec>20000000</nanosec>
        </max_blocking_time>
      </reliability>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </data_writer>

  <data_reader profile_name="humanoid_state_reader" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </data_reader>

</profiles>
