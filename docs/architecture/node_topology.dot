digraph Nodes {
  graph [rankdir=TB, bgcolor="#f7f9fc", pad="0.35", nodesep="0.38", ranksep="0.75", fontname="DejaVu Sans", fontsize=23, labelloc=t, label="Robot Node Topology\nRepository wiring and launch options — not a live process graph · not verified on the physical robot", compound=true, newrank=true];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#94a3b8", fontname="DejaVu Sans", fontsize=13, margin="0.16,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", arrowsize=0.75];

  subgraph cluster_inputs {
    label="SENSORS / HARDWARE"; color="#cbd5e1"; style="rounded"; fontsize=16;
    bodyimu [label="body_imu_mcu (ESP32-S3 + BNO085)\nmicro-ROS via micro_ros_agent\n/imu/data_raw 100 Hz · /imu/status", fillcolor="#e0f2fe"];
    motors [label="10 RobStride motors on can1\nMIT mode · status / fault frames", shape=cylinder, fillcolor="#e0f2fe"];
    camera [label="realsense2_camera_node\ncolor / aligned depth / CameraInfo", fillcolor="#e0f2fe"];
  }

  subgraph cluster_control {
    label="CONTROL — motor_control_hybrid"; color="#93c5fd"; style="rounded"; fontsize=16;
    onnx [label="tracking_policy_node\nONNX policy · 50 Hz\nmodel PD gains + trained joint bounds", fillcolor="#dbeafe"];
    cpp [label="cpp_control_node\ncontrol_core · 50 Hz\ncommand / feedback freshness, estop", fillcolor="#dbeafe"];
    subgraph cluster_backends {
      label="CAN BACKEND — exactly one (hybrid_control.launch.py can_backend:=)"; style="rounded,dashed"; color="#60a5fa"; fontsize=13;
      pycan [label="python_can_node (default)\nTX thread + per-bus RX threads\nper-joint deadlines / async enable ACK", fillcolor="#dbeafe"];
      cppcan [label="robstride_can_node (C++)\nsame contract, raw SocketCAN\nframe-identical to Python on vcan", fillcolor="#dbeafe"];
      fake [label="fake_motor_node\nenable_fake_motor:=true\nbench feedback, no dynamics", fillcolor="#f1f5f9"];
    }
    encos [label="encos_can_node\nENCOS actuators (not RobStride)\nskeleton, never run on motors", fillcolor="#f1f5f9", color="#cbd5e1"];
    feedback [label="JointState feedback\n/joint_states (hybrid / hardware)\n/policy/joint_states (ONNX bench)", shape=note, fillcolor="#ecfdf5"];
    bench [label="/policy/motor_commands\nONNX launch output stays isolated\nno CAN, no auto-enable", shape=note, fillcolor="#fef3c7"];
  }

  subgraph cluster_safety {
    label="SAFETY — humanoid_safety"; color="#fdba74"; style="rounded"; fontsize=16;
    safety [label="safety_node · 100 Hz\nfall detection, IMU freshness / stuck\nlatched estop · /safety/reset", fillcolor="#ffedd5"];
    stop [label="/safety/estop\nreliable · transient-local", shape=note, fillcolor="#fee2e2"];
    fallp [label="fall_predictor_node (opt-in)\nlearned 300 / 600 ms CNN, ONNX\nadvisory only — never trips estop", fillcolor="#ffedd5"];
    coll [label="self_collision_monitor_node\nmeasured / target / path clearance\nadvisory only", fillcolor="#ffedd5"];
  }

  subgraph cluster_monitors {
    label="READ-ONLY MONITORING — same ROS_DOMAIN_ID"; style="rounded"; color="#86efac"; fontsize=16;
    web [label="motor_web_node\nHTTP status, default 127.0.0.1:8080", fillcolor="#dcfce7"];
    browser [label="Web browser\nGET /api/status", fillcolor="#dcfce7"];
    relay [label="joint_state_monitor_node\nvalidate + relay, keep source stamps", fillcolor="#dcfce7"];
    rsp [label="robot_state_publisher", fillcolor="#dcfce7"];
    rviz [label="rviz2", fillcolor="#dcfce7"];
  }

  subgraph cluster_vision {
    label="VISION / HEAD — independent of the leg control path"; style="rounded"; color="#c4b5fd"; fontsize=16;
    detect [label="ball_detection_node\nYOLO + optional depth projection", fillcolor="#ede9fe"];
    tracker [label="track_node\npixel error → limited servo angle", fillcolor="#ede9fe"];
    head [label="head_mcu (ESP32-S3 + PCA9685)\nservo PWM + command watchdog\n/head/imu is not the body IMU", fillcolor="#ede9fe"];
  }

  subgraph cluster_legacy {
    label="LEGACY — retained, opt-in, bypass the C++ scheduler"; style="rounded,dashed"; penwidth=2.2; color="#dc2626"; fontcolor="#991b1b"; fontsize=15;
    torch [label="policy_bridge_node\nTorch adapter, separate contract", fillcolor="#fff1f2", color="#f87171"];
    gateway [label="motor_sdk_gateway_node\ngRPC → /motor_commands", fillcolor="#fff1f2", color="#f87171"];
    demo [label="double_pendulum_websocket_node\nWebSocket demo → /motor_commands", fillcolor="#fff1f2", color="#f87171"];
    serialimu [label="imu_reader_node\nserial IMU reader (alternative producer)", fillcolor="#fff1f2", color="#f87171"];
  }

  bodyimu -> onnx [label="/imu/data_raw"];
  bodyimu -> safety [label="/imu/data_raw"];
  bodyimu -> fallp [label="/imu/data_raw"];
  feedback -> onnx [label="joint_feedback_mode:=joint_states", constraint=false];
  feedback -> cpp [label="JointState", constraint=false];
  onnx -> cpp [label="/policy/desired_motor_subset\n(remapped bench instance)"];
  cpp -> pycan [label="/motor_commands"];
  cpp -> cppcan [label="/motor_commands"];
  cpp -> fake [label="/motor_commands"];
  cpp -> bench [label="ONNX launch remap"];
  bench -> fake [label="policy fake backend"];
  pycan -> motors [label="MIT / enable / disable / parameter frames"];
  cppcan -> motors [label="identical frames"];
  motors -> pycan [label="status / fault frames", constraint=false];
  motors -> cppcan [constraint=false];
  pycan -> feedback [label="JointState"];
  cppcan -> feedback [label="JointState"];
  fake -> feedback [label="JointState"];
  safety -> stop [label="Bool · latched"];
  safety -> cpp [label="/safety/status · warning only", color="#d97706"];
  stop -> cpp [color="#dc2626", constraint=false];
  stop -> pycan [color="#dc2626", constraint=false];
  stop -> cppcan [color="#dc2626", constraint=false];
  stop -> onnx [color="#dc2626", constraint=false];
  stop -> fake [color="#dc2626", constraint=false];
  stop -> fallp [label="gates windows", color="#dc2626", constraint=false];
  feedback -> coll [label="/joint_states"];
  onnx -> coll [label="/policy/target_angles"];
  feedback -> web [label="source_topic"];
  pycan -> web [label="/motor_telemetry"];
  web -> browser [label="HTTP"];
  feedback -> relay [label="source_topic"];
  relay -> rsp [label="/safety/visualization/joint_states"];
  rsp -> rviz [label="/tf · /robot_description"];
  camera -> detect [label="images + CameraInfo"];
  camera -> tracker [label="CameraInfo"];
  detect -> tracker [label="/vision/target_center"];
  tracker -> head [label="/head/servo_target_rad"];
  torch -> cpp [label="/desired_motor_subset", color="#dc2626"];
  gateway -> pycan [label="/motor_commands", color="#dc2626", constraint=false];
  demo -> pycan [label="/motor_commands", color="#dc2626", constraint=false];
  serialimu -> onnx [label="/imu/data_raw (instead of MCU)", color="#dc2626", style=dashed, constraint=false];

  legend [label="READING NOTES\nBoxes: ROS nodes / devices. Notes: topics or launch constraints.\nThe ONNX bench and the hybrid hardware path are separate launches; they are not composed automatically.\nOnly one CAN backend may own can1 at a time. The shipped motor registry is hardware_verified: false.\nAdvisory nodes (fall predictor, self-collision) publish warnings only; safety_node is the only estop authority.\nNot implemented: actual-speed / total-torque / tracking-error threshold checks.", shape=note, fillcolor="#ffffff", fontsize=12];
  rviz -> legend [style=invis];
}
