<?xml version="1.0"?>
<!--
  Full-body humanoid, fixed base at torso_link. Source of truth for the URDF:
  CMake runs xacro on this file and installs the result as urdf/full_body.urdf.

  Frames: torso_link has +z up and +y forward (knee flexion swings the foot toward -y); the left_* joints are on the
  +x side, as in the motor registry and the tracking policy's MJCF. At q = 0 the robot stands upright:
  legs straight, soles flat, arms hanging down (see README "Joint zero").

  Meshes: meshes/visual/<link>.stl is the link's CAD parts, each decimated (within 1-2 mm) and concatenated. meshes/collision/<link>.stl
  is one convex piece per part (box for screws, hull, or CoACD pieces for concave parts). Both are generated by scripts/simplify_meshes.py from cad_source/.
  Inertials come from the original CAD. Units: m, kg, kg*m^2, rad.
-->
<robot name="full_body" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_dir" value="package://humanoid_full_body_description/meshes"/>

  <material name="aluminum"><color rgba="0.62 0.62 0.62 1"/></material>
  <material name="dark_grey"><color rgba="0.33 0.33 0.33 1"/></material>
  <material name="light_grey"><color rgba="0.80 0.80 0.80 1"/></material>
  <material name="orange"><color rgba="1.0 0.63 0.06 1"/></material>

  <!-- A link whose visual and collision meshes are named after it.
       com is the inertial origin; inertia is "ixx ixy ixz iyy iyz izz" about the COM. -->
  <xacro:macro name="cad_link" params="name material mass com inertia">
    <xacro:property name="I" value="${inertia.split()}"/>
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${I[0]}" ixy="${I[1]}" ixz="${I[2]}" iyy="${I[3]}" iyz="${I[4]}" izz="${I[5]}"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/visual/${name}.stl"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_dir}/collision/${name}.stl"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- Unlimited rotation. The CAD export gives most joints no limits: set real ones once known. -->
  <xacro:macro name="continuous_joint" params="name parent child xyz rpy axis">
    <joint name="${name}" type="continuous">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
    </joint>
  </xacro:macro>

  <!-- effort/velocity are 0 in the CAD export. MoveIt takes velocity limits from joint_limits.yaml. -->
  <xacro:macro name="revolute_joint" params="name parent child xyz rpy axis lower upper">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="0" velocity="0"/>
    </joint>
  </xacro:macro>


  <!-- Torso (root link, fixed base) -->
  <!-- Shoulder mounts (base_link_333/314) changed from 6061 aluminium to printed ASA: -500 g each
       (measured: -1.0 kg for the pair). Mass, COM and inertia recomputed from the part geometry. -->
  <xacro:cad_link name="torso_link" material="aluminum"
                  mass="9.00169" com="-3.33673e-06 1.67621e-07 0.18077"
                  inertia="0.133271 3.91238e-05 2.75146e-06 0.23138 -1.64777e-06 0.129094"/>

  <!-- Pelvis: fixed to the torso; its top face sits flush on the torso bottom (z = 0) -->
  <xacro:cad_link name="pelvis_link" material="aluminum"
                  mass="3.52329" com="0.0762997 -0.103633 0.54283"
                  inertia="0.00733434 -0.000801202 -0.00142978 0.0170036 -0.000442447 0.0164294"/>
  <xacro:fixed_joint name="torso_to_pelvis" parent="torso_link" child="pelvis_link"
      xyz="-0.150094227 -0.340438733 0.346935879" rpy="-2.66879765 -0.177967639 0.00628281114"/>

  <!-- Left arm: shoulder pitch, roll, yaw, upper-arm twist (coaxial with the yaw), elbow.
       Axis signs are the CAD export's; not yet checked against the motors. -->
  <xacro:cad_link name="left_base_link" material="dark_grey"
                  mass="1.30369" com="-0.00467276 -0.0791327 0.000862798"
                  inertia="0.00274206 0.000115059 3.778e-05 0.00155435 -1.35312e-06 0.00262216"/>
  <xacro:cad_link name="left_link_001" material="dark_grey"
                  mass="0.733848" com="-0.0207453 0.000565026 -0.0591024"
                  inertia="0.00184176 7.76198e-07 -0.000119616 0.00215905 1.65746e-05 0.000986437"/>
  <xacro:cad_link name="left_link_002" material="dark_grey"
                  mass="0.0237171" com="-3.06873e-05 5.05098e-06 0.00228391"
                  inertia="1.58729e-06 0 -1.97056e-08 1.58703e-06 3.24344e-09 3.05362e-06"/>
  <xacro:cad_link name="left_link_003" material="dark_grey"
                  mass="0.684092" com="0.00131303 0.000269986 -0.0796064"
                  inertia="0.000936754 -2.83656e-07 6.62993e-06 0.000967344 1.24085e-05 0.000551426"/>
  <!-- Ball and block at the forearm end (link_004_004/_003) changed from steel to printed PLA, 20% infill with a
       1.2 mm solid shell: about 0.41-0.44 g/cm3 effective (85 g + 63 g per forearm). -->
  <xacro:cad_link name="left_link_004" material="orange"
                  mass="0.585745" com="0.00106618 0.032077 -0.0582626"
                  inertia="0.00215704 4.18874e-07 2.63315e-05 0.00175378 3.09155e-06 0.000749798"/>
  <xacro:continuous_joint name="left_shoulder_pitch_joint" parent="torso_link" child="left_base_link"
      xyz="0.1972044 0 0.2922097" rpy="0.00221104723 0.0247092937 1.57074348"
      axis="5.28303544e-05 -0.999997551 0.00221235109"/>
  <xacro:revolute_joint name="left_shoulder_roll_joint" parent="left_base_link" child="left_link_001"
      xyz="0.0266166538 -0.094309571 0.000566191355" rpy="0 0 0"
      axis="-0.999909744 -8.25207423e-05 -0.0134348988" lower="-0.261799388" upper="1.83259571"/>
  <xacro:revolute_joint name="left_shoulder_yaw_joint" parent="left_link_001" child="left_link_002"
      xyz="-0.0223931296 -0.000262979347 -0.118339241" rpy="0 0 0"
      axis="0.0134350484 -0.00221134321 -0.9999073" lower="-3.14159265" upper="3.14159265"/>
  <xacro:continuous_joint name="left_upper_arm_twist_joint" parent="left_link_002" child="left_link_003"
      xyz="6.71752421e-06 -1.10567161e-06 -0.00049995365" rpy="0 0 0"
      axis="0.0134350484 -0.00221134321 -0.9999073"/>
  <xacro:continuous_joint name="left_elbow_joint" parent="left_link_003" child="left_link_004"
      xyz="0.00155821224 -0.0319538078 -0.0889827107" rpy="0 0 0"
      axis="0.00109990674 -0.999996917 0.00222632008"/>

  <!-- Right arm: shoulder pitch, roll, yaw, upper-arm twist (coaxial with the yaw), elbow.
       Axis signs are the CAD export's; not yet checked against the motors. -->
  <xacro:cad_link name="right_base_link" material="dark_grey"
                  mass="1.30369" com="-0.00467276 0.0791327 0.000862798"
                  inertia="0.00274206 -0.000115059 3.778e-05 0.00155435 1.35312e-06 0.00262216"/>
  <xacro:cad_link name="right_link_001" material="dark_grey"
                  mass="0.733848" com="-0.0207453 -0.000565026 -0.0591024"
                  inertia="0.00184176 -7.76198e-07 -0.000119616 0.00215905 -1.65746e-05 0.000986437"/>
  <xacro:cad_link name="right_link_002" material="dark_grey"
                  mass="0.0237171" com="-3.06873e-05 -5.05098e-06 0.00228391"
                  inertia="1.58729e-06 0 -1.97056e-08 1.58703e-06 -3.24344e-09 3.05362e-06"/>
  <xacro:cad_link name="right_link_003" material="dark_grey"
                  mass="0.684092" com="0.00131303 -0.000269986 -0.0796064"
                  inertia="0.000936754 2.83656e-07 6.62993e-06 0.000967344 -1.24085e-05 0.000551426"/>
  <xacro:cad_link name="right_link_004" material="orange"
                  mass="0.585745" com="0.00106618 -0.032077 -0.0582626"
                  inertia="0.00215704 -4.18874e-07 2.63315e-05 0.00175378 -3.09155e-06 0.000749798"/>
  <xacro:continuous_joint name="right_shoulder_pitch_joint" parent="torso_link" child="right_base_link"
      xyz="-0.19722 0 0.2922097" rpy="-0.00221104723 0.0247092937 1.57084917"
      axis="-5.28303544e-05 -0.999997551 -0.00221235109"/>
  <xacro:revolute_joint name="right_shoulder_roll_joint" parent="right_base_link" child="right_link_001"
      xyz="0.0266166538 0.094309571 0.000566191355" rpy="0 0 0"
      axis="0.999909744 -8.25207423e-05 0.0134348988" lower="-0.261799388" upper="1.83259571"/>
  <xacro:revolute_joint name="right_shoulder_yaw_joint" parent="right_link_001" child="right_link_002"
      xyz="-0.0223931296 0.000262979347 -0.118339241" rpy="0 0 0"
      axis="-0.0134350484 -0.00221134321 0.9999073" lower="-3.14159265" upper="3.14159265"/>
  <xacro:continuous_joint name="right_upper_arm_twist_joint" parent="right_link_002" child="right_link_003"
      xyz="6.71752421e-06 1.10567161e-06 -0.00049995365" rpy="0 0 0"
      axis="-0.0134350484 -0.00221134321 0.9999073"/>
  <xacro:continuous_joint name="right_elbow_joint" parent="right_link_003" child="right_link_004"
      xyz="0.00155821224 0.0319538078 -0.0889827107" rpy="0 0 0"
      axis="-0.00109990674 -0.999996917 -0.00222632008"/>

  <!-- Left leg: hip pitch (hip1), hip roll (hip2), hip yaw (thigh), knee, ankle pitch. Names, axis signs and ranges
       match the tracking policy's MJCF (motor_control_hybrid/models/*/chrobot_16kg_candidate.xml). -->
  <xacro:cad_link name="left_pelvis_hip_connector_link" material="aluminum"
                  mass="1.1951" com="0.0723796 0.00633066 0.0114876"
                  inertia="0.00111526 -4.36942e-05 -5.58966e-05 0.0016302 -2.64521e-05 0.00147137"/>
  <xacro:cad_link name="left_hip_link" material="aluminum"
                  mass="1.70614" com="0.0186449 -0.0473243 -0.084222"
                  inertia="0.00616266 0.000113173 0.000470104 0.00512474 -7.10545e-05 0.00354562"/>
  <xacro:cad_link name="left_thigh_link" material="aluminum"
                  mass="1.88724" com="0.0190879 -0.0133638 -0.108895"
                  inertia="0.00413859 -0.00032446 0.000394036 0.00367899 -0.000248043 0.00224382"/>
  <xacro:cad_link name="left_shank_link" material="aluminum"
                  mass="1.02324" com="-0.0348549 -0.0468275 -0.107714"
                  inertia="0.0046623 -2.54876e-05 -0.000200659 0.00371896 -0.00152528 0.00230065"/>
  <xacro:cad_link name="left_foot_link" material="light_grey"
                  mass="0.574351" com="-0.0172632 -0.012309 -0.0206316"
                  inertia="0.00139239 -0.000547602 0.000269881 0.000912113 0.000439213 0.00161229"/>
  <xacro:revolute_joint name="left_hip1_joint" parent="pelvis_link" child="left_pelvis_hip_connector_link"
      xyz="0.162071443 -0.0953412766 0.557905363" rpy="2.76113083 -0.269845023 0.226998553"
      axis="0.984186863 0.0862037448 0.154742152" lower="-1.57" upper="1.57"/>
  <xacro:revolute_joint name="left_hip2_joint" parent="left_pelvis_hip_connector_link" child="left_hip_link"
      xyz="0.0737048714 0.0550664328 0.00563550961" rpy="4.23737092e-05 -0.000640310371 8.70081734e-05"
      axis="-0.0654764958 0.988764442 -0.134378968" lower="-1.57" upper="0.436332"/>
  <xacro:revolute_joint name="left_thigh_joint" parent="left_hip_link" child="left_thigh_link"
      xyz="0.0295594845 -0.0547547636 -0.14407719" rpy="-0.0776151432 0.0924315186 0.551502114"
      axis="0.178036925 -0.120931244 -0.976564636" lower="-0.785398" upper="0.785398"/>
  <xacro:revolute_joint name="left_knee_joint" parent="left_thigh_link" child="left_shank_link"
      xyz="0.0619897282 -0.0366673728 -0.105889876" rpy="0.437557176 -0.257361005 0.0553440268"
      axis="0.857488443 -0.467770139 0.214253745" lower="-2.0944" upper="0"/>
  <xacro:revolute_joint name="left_ankle_joint" parent="left_shank_link" child="left_foot_link"
      xyz="-0.0449392869 -0.135544469 -0.236190673" rpy="-0.0865500603 0.0459238764 -0.0234921337"
      axis="0.857488443 -0.467770139 0.214253745" lower="-0.6" upper="0.6"/>

  <!-- Right leg: hip pitch (hip1), hip roll (hip2), hip yaw (thigh), knee, ankle pitch. Names, axis signs and ranges
       match the tracking policy's MJCF (motor_control_hybrid/models/*/chrobot_16kg_candidate.xml). -->
  <xacro:cad_link name="right_pelvis_hip_connector_link" material="aluminum"
                  mass="1.19906" com="-0.0718408 -0.00636457 -0.0112483"
                  inertia="0.00111705 -2.63053e-05 -6.12627e-05 0.00160606 -7.39441e-05 0.00151158"/>
  <xacro:cad_link name="right_hip_link" material="aluminum"
                  mass="1.70615" com="1.61803e-06 -0.0122267 -0.0973212"
                  inertia="0.00629064 5.12511e-08 1.05532e-07 0.00484818 -0.000645262 0.00377303"/>
  <xacro:cad_link name="right_thigh_link" material="aluminum"
                  mass="1.87557" com="0.00071249 -0.0541604 -0.0977563"
                  inertia="0.00431864 1.322e-05 1.67633e-06 0.00312282 -0.000550819 0.00243267"/>
  <xacro:cad_link name="right_shank_link" material="aluminum"
                  mass="1.00899" com="0.0309799 0.00264944 -0.118363"
                  inertia="0.00460144 -2.06611e-05 -9.19348e-05 0.00476998 8.2796e-05 0.00130264"/>
  <xacro:cad_link name="right_foot_link" material="aluminum"
                  mass="0.569755" com="-0.012229 -0.0113595 -0.0248806"
                  inertia="0.00175725 -1.91761e-05 -5.71493e-06 0.000354471 -0.000150987 0.00181707"/>
  <xacro:revolute_joint name="right_hip1_joint" parent="pelvis_link" child="right_pelvis_hip_connector_link"
      xyz="-0.00969672135 -0.110386244 0.530898525" rpy="-3.13456088 -0.312485816 0.173623974"
      axis="0.984186863 0.0862037448 0.154742152" lower="-1.57" upper="1.57"/>
  <xacro:revolute_joint name="right_hip2_joint" parent="right_pelvis_hip_connector_link" child="right_hip_link"
      xyz="-0.0769224211 -0.038811057 0.00577311957" rpy="-0.00394139381 -0.118540604 0.0663964245"
      axis="0 0.873591353 -0.486660197" lower="-0.436332" upper="1.57"/>
  <xacro:revolute_joint name="right_thigh_joint" parent="right_hip_link" child="right_thigh_link"
      xyz="2.36742928e-06 -0.0421839172 -0.151164152" rpy="5.61636194e-05 0.00791014937 0.0142000815"
      axis="0 0.486660197 0.873591353" lower="-0.785398" upper="0.785398"/>
  <xacro:revolute_joint name="right_knee_joint" parent="right_thigh_link" child="right_shank_link"
      xyz="-0.0476200751 -0.0578377746 -0.103860526" rpy="-0.510161448 0 0"
      axis="1.0 0 0" lower="-2.0944" upper="0"/>
  <xacro:revolute_joint name="right_ankle_joint" parent="right_shank_link" child="right_foot_link"
      xyz="0.0519680999 0.000540779603 -0.274801069" rpy="-0.043064997 0 0"
      axis="1 0 0" lower="-0.6" upper="0.6"/>
</robot>
