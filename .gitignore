# colcon / ROS2 build artifacts
build/
install/
log/

# optional: colcon test results
test_results/

# Python cache
__pycache__/
*.py[cod]
rosenv/

# VSCode / CLion / misc
.vscode/
.idea/
.DS_Store

# common binaries
*.so
*.a
*.o

#AI
.codex/
.agents/
.skills-lock.json

# Project-local development dependencies and TensorRT engines
.deps/

# Generated by direct CMake installs
symlink_install_manifest.txt

# Local review / verification artifacts: audit reports, throwaway colcon
# overlays for isolated builds (build_verify, install_verify) and ROS log dirs.
# Everything here is disposable and must never be committed.
local_test/

# Runtime logs and local build/tool databases
*.log
compile_commands.json
.pio/
.pytest_cache/

# Overnight simulated fall trajectories and per-episode logs
data/fall_collection/
data/fall_training/
# Local raw simulation experiment output
experimental/reference_warp/results/
# Ball-chase TensorRT engines (scripts/build_ball_chase_engines.sh), device-specific
simulation/humanoid_ball_chase/assets/*.engine
simulation/humanoid_ball_chase/assets/*.engine.json
simulation/humanoid_ball_chase/assets/*.engine.log
simulation/humanoid_ball_chase/assets/*.engine.tmp
simulation/humanoid_ball_chase/assets/.trt-timing.cache*
